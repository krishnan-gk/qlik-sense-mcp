# =============================================================================
# Per-user environment file for central server deployment.
# Copy this file to users/<username>.env and fill in the user's credentials.
# NEVER commit real credentials to git.
# =============================================================================

# Qlik Server (same for all users)
QLIK_SERVER_URL=https://qlik-dev.ispot.tv
QLIK_REPOSITORY_PORT=4242
QLIK_PROXY_PORT=4243
QLIK_ENGINE_PORT=4747
QLIK_VERIFY_SSL=false

# User-specific identity (this is what Section Access uses)
QLIK_USER_DIRECTORY=ANALYTICSUSERS
QLIK_USER_ID=firstname.lastname@ispot.tv

# Certificate paths (mounted into container at /certs)
QLIK_CLIENT_CERT_PATH=/certs/client.pem
QLIK_CLIENT_KEY_PATH=/certs/client_key.pem
# QLIK_CA_CERT_PATH=/certs/root.pem

# Timeouts
QLIK_HTTP_TIMEOUT=10.0
QLIK_WS_TIMEOUT=8.0
QLIK_WS_RETRIES=2
